{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    // `$app/types` (SvelteKit's, required) plus the global namespaces the
    // Google Drive integration uses (`gapi`, `google.accounts`,
    // `google.picker`). Since TypeScript 6 nothing in node_modules/@types is
    // global unless it is listed here.
    "types": ["$app/types", "gapi", "gapi.client.drive-v3", "google.accounts", "google.picker"]
  },
  // What SvelteKit 2's generated config type-checked: the app and vite.config.ts.
  "include": ["src", "vite.config.ts"],
  // The service worker runs in a worker scope, not a window: it is not part of
  // this program (SvelteKit warns until it is excluded).
  "exclude": ["src/service-worker.js"]
}
